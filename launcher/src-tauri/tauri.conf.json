{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Majistic Launcher",
  "version": "0.1.0",
  "identifier": "com.majistic.launcher",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Majistic Recomp - Launcher",
        "width": 540,
        "height": 720,
        "resizable": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
