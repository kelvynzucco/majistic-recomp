{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Majistic Launcher",
  "version": "0.1.0",
  "identifier": "com.majistic.launcher",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Majistic Recomp - Launcher",
        "width": 940,
        "height": 600,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
