-    : AchievementNotificationDialog(drawer), icon_cache_(immediate_drawer, runtime) {}
+    : AchievementNotificationDialog(drawer), icon_cache_(immediate_drawer, runtime) {
+  // Detach from ImGuiDrawer while idle so Presenter remains in
+  // PaintMode::kGuestOutputThreadImmediately and does not run a continuous
