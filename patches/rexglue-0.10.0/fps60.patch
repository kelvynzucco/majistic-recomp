 namespace rex::ui::d3d12 {
 
+namespace {
+class MajinFramePacer {
+ public:
+  ~MajinFramePacer() {
+#if defined(_WIN32)
+    if (timer_) CloseHandle(timer_);
+#endif
+  }
+  void Wait() {
+    if (!rex::cvar::Query<bool>("majin_60fps")) return;
+    constexpr uint32_t fps = 60;
+    const auto frequency = rex::chrono::Clock::QueryHostTickFrequency();
+    auto now = rex::chrono::Clock::QueryHostTickCount();
+    const auto target = deadline_.Next(now, frequency, fps);
+#if defined(_WIN32)
+    if (!initialized_) {
+      initialized_ = true;
+      timer_ = CreateWaitableTimerExW(nullptr, nullptr, 0x00000002,
+                                     TIMER_MODIFY_STATE | SYNCHRONIZE);
+      if (!timer_) timer_ = CreateWaitableTimerExW(nullptr, nullptr, 0,
+                                     TIMER_MODIFY_STATE | SYNCHRONIZE);
+      REXLOG_INFO("[Majin 60 FPS] D3D12 presenter swap_limit={} waitable_timer={}", fps, bool(timer_));
+    }
+#endif
+    while (now < target) {
+      const auto remaining = target - now;
+#if defined(_WIN32)
+      LARGE_INTEGER due;
+      due.QuadPart = -int64_t(std::max(uint64_t(1), remaining * 10000000 / frequency));
+      if (timer_ && SetWaitableTimer(timer_, &due, 0, nullptr, nullptr, FALSE))
+        WaitForSingleObject(timer_, 40);
+      else
+#endif
+        std::this_thread::sleep_for(std::chrono::microseconds(
+            std::max(uint64_t(1), remaining * 1000000 / frequency)));
+      now = rex::chrono::Clock::QueryHostTickCount();
+    }
+  }
+ private:
+  majin::timing::SwapDeadline deadline_;
+#if defined(_WIN32)
+  HANDLE timer_ = nullptr;
+  bool initialized_ = false;
+#endif
+};
+} // namespace
