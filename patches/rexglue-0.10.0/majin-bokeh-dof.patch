+void CommandProcessor::SetDesiredMajinDofIntensity(float intensity) {
+  intensity = std::clamp(intensity, 0.0f, 2.0f);
+  if (majin_dof_intensity_desired_ == intensity) {
+    return;
+  }
+  majin_dof_intensity_desired_ = intensity;
+  majin_dof_intensity_actual_.store(intensity, std::memory_order_relaxed);
+  CallInThread([this, intensity]() {
+    majin_dof_intensity_actual_.store(intensity, std::memory_order_relaxed);
+  });
+}
+
+void CommandProcessor::SetDesiredMajinDofBokeh(bool bokeh) {
+  if (majin_dof_bokeh_desired_ == bokeh) {
+    return;
+  }
+  majin_dof_bokeh_desired_ = bokeh;
+  majin_dof_bokeh_actual_.store(bokeh, std::memory_order_relaxed);
+  CallInThread([this, bokeh]() {
+    majin_dof_bokeh_actual_.store(bokeh, std::memory_order_relaxed);
+  });
+}
