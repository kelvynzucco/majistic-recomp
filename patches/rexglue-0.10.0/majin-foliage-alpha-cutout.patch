+void Shader::DetectMajinBayerDither() {
+  // Detects Majin's ALU-evaluated 4x4 Bayer screen-door dither pattern:
+  //   3 vector cndeq (write_mask == 0b1111, selecting row from high literal constants c248..c255)
+  //   3 scalar cndeq (1-component writes, selecting column element from row_reg)
+  //   immediately followed by add(..., -bayer) or mad(..., ..., -bayer).
+  uint32_t vec_cndeq_count = 0;
+  uint32_t row_reg = UINT32_MAX;
+  uint32_t scalar_stage = 0;
+  uint32_t s_reg = UINT32_MAX;
+  uint32_t s_comp = 0;
+  uint32_t candidate_offset = UINT32_MAX;
+
+  for (uint32_t i = 0; i < cf_pair_index_bound_; ++i) {
+    ControlFlowInstruction cf_ab[2];
+    UnpackControlFlowInstructions(ucode_data_.data() + i * 3, cf_ab);
+    for (uint32_t j = 0; j < 2; ++j) {
+      const ControlFlowInstruction& cf = cf_ab[j];
+      if (!IsControlFlowOpcodeExec(cf.opcode())) {
+        continue;
+      }
+      uint32_t cf_index = i * 2 + j;
+      ParsedExecInstruction exec_instr;
+      switch (cf.opcode()) {
+        case ControlFlowOpcode::kExec:
+        case ControlFlowOpcode::kExecEnd:
+          ParseControlFlowExec(cf.exec, cf_index, exec_instr);
+          break;
+        case ControlFlowOpcode::kCondExec:
+        case ControlFlowOpcode::kCondExecEnd:
