+void Shader::DetectMajinShadowLookups() {
+  // Detects Majin's KbPreZSSSM* shadow depth lookup + reversed-Z compare pattern:
+  //   1. tfetch2D rA.x___, uv, tf7/tf6/tf5 (2D normalized, 1-component .x write)
+  //   2. min rB.cB, rawZ, cHigh + subsc rA.x___, cHigh, rA.x (1.0 - smRaw)
+  //   3. sgt rA.x___, rA.xxxx, rB.cB (+ retain_prev no-op scalar)
+  uint32_t pending_stage = 0;
+  uint32_t pending_tfetch_offset = UINT32_MAX;
+  uint32_t pending_fetch_constant = 0;
+  uint32_t pending_reg = UINT32_MAX;
+  uint32_t pending_z_reg = UINT32_MAX;
+  uint32_t pending_z_comp = 0;
+
+  for (uint32_t i = 0; i < cf_pair_index_bound_; ++i) {
+    ControlFlowInstruction cf_ab[2];
+    UnpackControlFlowInstructions(ucode_data_.data() + i * 3, cf_ab);
+    for (uint32_t j = 0; j < 2; ++j) {
+      const ControlFlowInstruction& cf = cf_ab[j];
+      if (!IsControlFlowOpcodeExec(cf.opcode())) {
+        continue;
+      }
+      uint32_t cf_index = i * 2 + j;
+      ParsedExecInstruction exec_instr;
+      switch (cf.opcode()) {
+        case ControlFlowOpcode::kExec:
+        case ControlFlowOpcode::kExecEnd:
+          ParseControlFlowExec(cf.exec, cf_index, exec_instr);
+          break;
+        case ControlFlowOpcode::kCondExec:
+        case ControlFlowOpcode::kCondExecEnd:
+        case ControlFlowOpcode::kCondExecPredClean:
+        case ControlFlowOpcode::kCondExecPredCleanEnd:
+          ParseControlFlowCondExec(cf.cond_exec, cf_index, exec_instr);
+          break;
