+void CommandProcessor::SetDesiredShadowPcfMode(ShadowPcfMode mode) {
+  if (shadow_pcf_mode_desired_ == mode) {
+    return;
+  }
+  shadow_pcf_mode_desired_ = mode;
+  shadow_pcf_mode_actual_.store(mode, std::memory_order_relaxed);
+  CallInThread([this, mode]() {
+    shadow_pcf_mode_actual_.store(mode, std::memory_order_relaxed);
+  });
+}
+
+void CommandProcessor::SetDesiredShadowReceiverBias(bool enable) {
+  if (shadow_receiver_bias_desired_ == enable) {
+    return;
+  }
+  shadow_receiver_bias_desired_ = enable;
+  shadow_receiver_bias_actual_.store(enable, std::memory_order_relaxed);
+  CallInThread([this, enable]() {
+    shadow_receiver_bias_actual_.store(enable, std::memory_order_relaxed);
+  });
+}
