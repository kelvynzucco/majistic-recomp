+spv::Id SpirvShaderTranslator::EmitMajinShadowPcf(spv::Id original_lit, spv::Id receiver_z,
+                                                  size_t image_binding_index,
+                                                  size_t sampler_binding_index) {
+  // Load packed Majin shadow params from SystemConstants::fh1_padding[1]:
+  //   bits 0..1: pcf_mode (0=original 1-tap, 1=2x2 bilinear, 2=4x4 cubic B-spline, 3=6x6 tent)
+  //   bit  2:    receiver_plane_bias_enable (0=off, 1=on)
+  std::vector<spv::Id> idx = {builder_->makeIntConstant(kSystemConstantMajinShadowParams)};
+  spv::Id shadow_params = builder_->createLoad(
+      builder_->createAccessChain(spv::StorageClassUniform, uniform_system_constants_, idx),
+      spv::NoPrecision);
+  spv::Id pcf_mode = builder_->createTriOp(spv::OpBitFieldUExtract, type_uint_, shadow_params,
+                                           const_uint_0_, builder_->makeUintConstant(2));
+  spv::Id is_pcf = builder_->createBinOp(spv::OpINotEqual, type_bool_, pcf_mode, const_uint_0_);
+
+  SpirvBuilder::IfBuilder if_pcf(is_pcf, spv::SelectionControlDontFlattenMask, *builder_);
+  spv::Id pcf_lit = original_lit;
+  {
+    spv::Id uv = builder_->createLoad(var_main_majin_shadow_uv_, spv::NoPrecision);
+    spv::Id image =
+        builder_->createLoad(texture_bindings_[image_binding_index].variable, spv::NoPrecision);
+    spv::Id sampler =
+        builder_->createLoad(sampler_bindings_[sampler_binding_index].variable, spv::NoPrecision);
+    spv::Id sampled_image_type = builder_->makeSampledImageType(builder_->getTypeId(image));
+
+    // Query live host shadow-map resolution (768 at 1x, 1536 at 2x, 3072 at 4x).
+    builder_->addCapability(spv::CapabilityImageQuery);
+    spv::Id size_int3 =
+        builder_->createBinOp(spv::OpImageQuerySizeLod, type_int3_, image, const_int_0_);
+    spv::Id size_x = builder_->createUnaryOp(
+        spv::OpConvertSToF, type_float_,
+        builder_->createCompositeExtract(size_int3, type_int_, 0));
+    spv::Id size_y = builder_->createUnaryOp(
+        spv::OpConvertSToF, type_float_,
+        builder_->createCompositeExtract(size_int3, type_int_, 1));
+    spv::Id tex_size = builder_->createCompositeConstruct(type_float2_, {size_x, size_y});
+    spv::Id inv_size_x =
+        builder_->createNoContractionBinOp(spv::OpFDiv, type_float_, const_float_1_, size_x);
+    spv::Id inv_size_y =
+        builder_->createNoContractionBinOp(spv::OpFDiv, type_float_, const_float_1_, size_y);
+
+    // Center gather UV on the exact 2x2 quad boundary (baseTexel = floor(uv*size + 0.5)) so
+    // hardware 8-bit sub-texel fixed-point rounding never crosses a texel seam.
+    spv::Id const_0_5 = builder_->makeFloatConstant(0.5f);
+    spv::Id const_vec2_0_5 = builder_->makeCompositeConstant(type_float2_, {const_0_5, const_0_5});
+    spv::Id texel_coord =
+        builder_->createNoContractionBinOp(spv::OpFMul, type_float2_, uv, tex_size);
+    spv::Id texel_pos =
+        builder_->createNoContractionBinOp(spv::OpFAdd, type_float2_, texel_coord, const_vec2_0_5);
+    spv::Id base_texel = builder_->createUnaryBuiltinCall(type_float2_, ext_inst_glsl_std_450_,
+                                                          GLSLstd450Floor, texel_pos);
+    spv::Id frac =
+        builder_->createNoContractionBinOp(spv::OpFSub, type_float2_, texel_pos, base_texel);
+
+    spv::Id base_x = builder_->createCompositeExtract(base_texel, type_float_, 0);
+    spv::Id base_y = builder_->createCompositeExtract(base_texel, type_float_, 1);
+    spv::Id fx = builder_->createCompositeExtract(frac, type_float_, 0);
+    spv::Id fy = builder_->createCompositeExtract(frac, type_float_, 1);
+
+    // Screen-space Receiver Plane Depth Bias (dz/dtx, dz/dty) via 2x2 Jacobian inverse.
+    spv::Id rpb_bit = builder_->createTriOp(spv::OpBitFieldUExtract, type_uint_, shadow_params,
+                                            builder_->makeUintConstant(2),
+                                            builder_->makeUintConstant(1));
+    spv::Id rpb_on = builder_->createBinOp(spv::OpINotEqual, type_bool_, rpb_bit, const_uint_0_);
+
+    builder_->addCapability(spv::CapabilityDerivativeControl);
+    spv::Id dtx_dx = builder_->createUnaryOp(spv::OpDPdxFine, type_float2_, texel_coord);
+    spv::Id dtx_dy = builder_->createUnaryOp(spv::OpDPdyFine, type_float2_, texel_coord);
+    spv::Id dz_dx = builder_->createUnaryOp(spv::OpDPdxFine, type_float_, receiver_z);
+    spv::Id dz_dy = builder_->createUnaryOp(spv::OpDPdyFine, type_float_, receiver_z);
+
+    spv::Id dtx_dx_x = builder_->createCompositeExtract(dtx_dx, type_float_, 0);
+    spv::Id dtx_dx_y = builder_->createCompositeExtract(dtx_dx, type_float_, 1);
+    spv::Id dtx_dy_x = builder_->createCompositeExtract(dtx_dy, type_float_, 0);
+    spv::Id dtx_dy_y = builder_->createCompositeExtract(dtx_dy, type_float_, 1);
+
+    spv::Id det = builder_->createNoContractionBinOp(
+        spv::OpFSub, type_float_,
+        builder_->createNoContractionBinOp(spv::OpFMul, type_float_, dtx_dx_x, dtx_dy_y),
+        builder_->createNoContractionBinOp(spv::OpFMul, type_float_, dtx_dx_y, dtx_dy_x));
+    spv::Id abs_det = builder_->createUnaryBuiltinCall(type_float_, ext_inst_glsl_std_450_,
+                                                       GLSLstd450FAbs, det);
+    auto fabs_s = [&](spv::Id v) {
+      return builder_->createUnaryBuiltinCall(type_float_, ext_inst_glsl_std_450_, GLSLstd450FAbs,
+                                              v);
+    };
+    spv::Id max_step_x = builder_->createBinBuiltinCall(
+        type_float_, ext_inst_glsl_std_450_, GLSLstd450NMax, fabs_s(dtx_dx_x), fabs_s(dtx_dx_y));
+    spv::Id max_step_y = builder_->createBinBuiltinCall(
+        type_float_, ext_inst_glsl_std_450_, GLSLstd450NMax, fabs_s(dtx_dy_x), fabs_s(dtx_dy_y));
+    spv::Id max_step = builder_->createBinBuiltinCall(type_float_, ext_inst_glsl_std_450_,
+                                                      GLSLstd450NMax, max_step_x, max_step_y);
+
+    // Guard against degenerate Jacobians and cascade/silhouette quad discontinuities.
+    // Compare UV step in normalized shadow-map space (5% of map per pixel) so foreshortened
+    // floors stay RPB-protected at 1x, 2x, and 4x shadow scales without creating moving bands.
+    spv::Id max_dz = builder_->createBinBuiltinCall(type_float_, ext_inst_glsl_std_450_,
+                                                    GLSLstd450NMax, fabs_s(dz_dx), fabs_s(dz_dy));
+    spv::Id step_limit = builder_->createNoContractionBinOp(
+        spv::OpFMul, type_float_, size_x, builder_->makeFloatConstant(0.05f));
+    spv::Id det_ok = builder_->createBinOp(spv::OpFOrdGreaterThan, type_bool_, abs_det,
+                                           builder_->makeFloatConstant(1e-6f));
+    spv::Id step_ok = builder_->createBinOp(spv::OpFOrdLessThan, type_bool_, max_step, step_limit);
+    spv::Id dz_ok = builder_->createBinOp(spv::OpFOrdLessThan, type_bool_, max_dz,
+                                          builder_->makeFloatConstant(0.02f));
+    spv::Id rpb_valid = builder_->createBinOp(
+        spv::OpLogicalAnd, type_bool_, rpb_on,
+        builder_->createBinOp(
+            spv::OpLogicalAnd, type_bool_, det_ok,
+            builder_->createBinOp(spv::OpLogicalAnd, type_bool_, step_ok, dz_ok)));
+
+    spv::Id safe_det = builder_->createTriOp(spv::OpSelect, type_float_, rpb_valid, det,
+                                             const_float_1_);
+    spv::Id inv_det =
+        builder_->createNoContractionBinOp(spv::OpFDiv, type_float_, const_float_1_, safe_det);
+
+    spv::Id raw_dz_dtx = builder_->createNoContractionBinOp(
+        spv::OpFMul, type_float_,
+        builder_->createNoContractionBinOp(
+            spv::OpFSub, type_float_,
+            builder_->createNoContractionBinOp(spv::OpFMul, type_float_, dtx_dy_y, dz_dx),
+            builder_->createNoContractionBinOp(spv::OpFMul, type_float_, dtx_dx_y, dz_dy)),
+        inv_det);
+    spv::Id raw_dz_dty = builder_->createNoContractionBinOp(
+        spv::OpFMul, type_float_,
+        builder_->createNoContractionBinOp(
+            spv::OpFSub, type_float_,
+            builder_->createNoContractionBinOp(spv::OpFMul, type_float_, dtx_dx_x, dz_dy),
+            builder_->createNoContractionBinOp(spv::OpFMul, type_float_, dtx_dy_x, dz_dx)),
+        inv_det);
+
+    spv::Id slope_min = builder_->makeFloatConstant(-0.0025f);
+    spv::Id slope_max = builder_->makeFloatConstant(0.0025f);
+    spv::Id dz_dtx = builder_->createTriOp(
+        spv::OpSelect, type_float_, rpb_valid,
+        builder_->createTriBuiltinCall(type_float_, ext_inst_glsl_std_450_, GLSLstd450NClamp,
+                                       raw_dz_dtx, slope_min, slope_max),
+        const_float_0_);
+    spv::Id dz_dty = builder_->createTriOp(
+        spv::OpSelect, type_float_, rpb_valid,
+        builder_->createTriBuiltinCall(type_float_, ext_inst_glsl_std_450_, GLSLstd450NClamp,
+                                       raw_dz_dty, slope_min, slope_max),
+        const_float_0_);
+
+    // Subtle quantization epsilon when RPB is enabled (~2-4mm over shadow range) so 24-bit float
+    // depth self-fighting on two-sided floors is prevented at Zero Bias without Peter-Panning.
+    spv::Id self_eps = builder_->createTriOp(
+        spv::OpSelect, type_float_, rpb_on, builder_->makeFloatConstant(0.00005f), const_float_0_);
+    spv::Id base_ref_z =
+        builder_->createNoContractionBinOp(spv::OpFSub, type_float_, receiver_z, self_eps);
+    spv::Id base_ref_z4 = builder_->smearScalar(spv::NoPrecision, base_ref_z, type_float4_);
+    spv::Id total_dz_min = builder_->makeFloatConstant(-0.0030f);
+    spv::Id total_dz_max = builder_->makeFloatConstant(0.0040f);
+    spv::Id clamp_dz_min4 = builder_->makeCompositeConstant(
+        type_float4_, {total_dz_min, total_dz_min, total_dz_min, total_dz_min});
+    spv::Id clamp_dz_max4 = builder_->makeCompositeConstant(
+        type_float4_, {total_dz_max, total_dz_max, total_dz_max, total_dz_max});
+
+    // Helper emitting one 2x2 OpImageGather at (base_texel + (gx, gy)) * inv_size,
+    // comparing all 4 depths against receiver-plane-biased refZ and summing weighted visibility.
+    // Vulkan/GLSL gather component order: .x=(0,1), .y=(1,1), .z=(1,0), .w=(0,0).
+    auto emit_gather_contrib = [&](spv::Id sampled_img, float gx, float gy, spv::Id wx0,
+                                   spv::Id wx1, spv::Id wy0, spv::Id wy1) -> spv::Id {
+      spv::Id gx_id = builder_->makeFloatConstant(gx);
+      spv::Id gy_id = builder_->makeFloatConstant(gy);
+      spv::Id gu = builder_->createNoContractionBinOp(
+          spv::OpFMul, type_float_,
+          gx != 0.0f ? builder_->createNoContractionBinOp(spv::OpFAdd, type_float_, base_x, gx_id)
+                     : base_x,
+          inv_size_x);
+      spv::Id gv = builder_->createNoContractionBinOp(
+          spv::OpFMul, type_float_,
+          gy != 0.0f ? builder_->createNoContractionBinOp(spv::OpFAdd, type_float_, base_y, gy_id)
+                     : base_y,
+          inv_size_y);
+
+      spv::Builder::TextureParameters tp = {};
+      tp.sampler = sampled_img;
+      tp.coords = builder_->createCompositeConstruct(type_float3_, {gu, gv, const_float_0_});
+      tp.component = const_int_0_;
+      spv::Id gathered = builder_->createTextureCall(spv::NoPrecision, type_float4_, false, false,
+                                                     false, true, false, tp,
+                                                     spv::ImageOperandsMaskNone);
+
+      // Reversed-Z conversion matching guest: smDepth = 1.0 - smRaw.
+      spv::Id sm_depth4 =
+          builder_->createNoContractionBinOp(spv::OpFSub, type_float4_, const_float4_1_, gathered);
+
+      // Per-tap texel offsets from fragment: left=(gx - fx), right=(gx + 1 - fx), etc.
+      spv::Id du0 = builder_->createNoContractionBinOp(
+          spv::OpFMul, type_float_,
+          builder_->createNoContractionBinOp(spv::OpFSub, type_float_, gx_id, fx), dz_dtx);
+      spv::Id du1 = builder_->createNoContractionBinOp(
+          spv::OpFMul, type_float_,
+          builder_->createNoContractionBinOp(spv::OpFSub, type_float_,
+                                             builder_->makeFloatConstant(gx + 1.0f), fx),
+          dz_dtx);
+      spv::Id dv0 = builder_->createNoContractionBinOp(
+          spv::OpFMul, type_float_,
+          builder_->createNoContractionBinOp(spv::OpFSub, type_float_, gy_id, fy), dz_dty);
+      spv::Id dv1 = builder_->createNoContractionBinOp(
+          spv::OpFMul, type_float_,
+          builder_->createNoContractionBinOp(spv::OpFSub, type_float_,
+                                             builder_->makeFloatConstant(gy + 1.0f), fy),
+          dz_dty);
+
+      spv::Id dz_x = builder_->createNoContractionBinOp(spv::OpFAdd, type_float_, du0, dv1);
+      spv::Id dz_y = builder_->createNoContractionBinOp(spv::OpFAdd, type_float_, du1, dv1);
+      spv::Id dz_z = builder_->createNoContractionBinOp(spv::OpFAdd, type_float_, du1, dv0);
+      spv::Id dz_w = builder_->createNoContractionBinOp(spv::OpFAdd, type_float_, du0, dv0);
+      spv::Id dz4 = builder_->createTriBuiltinCall(
+          type_float4_, ext_inst_glsl_std_450_, GLSLstd450NClamp,
+          builder_->createCompositeConstruct(type_float4_, {dz_x, dz_y, dz_z, dz_w}), clamp_dz_min4,
+          clamp_dz_max4);
+      spv::Id ref4 =
+          builder_->createNoContractionBinOp(spv::OpFAdd, type_float4_, base_ref_z4, dz4);
+      spv::Id lit4 = builder_->createTriOp(
+          spv::OpSelect, type_float4_,
+          builder_->createBinOp(spv::OpFOrdGreaterThan, type_bool4_, sm_depth4, ref4),
+          const_float4_1_, const_float4_0_);
+
+      spv::Id w_x = builder_->createNoContractionBinOp(spv::OpFMul, type_float_, wx0, wy1);
+      spv::Id w_y = builder_->createNoContractionBinOp(spv::OpFMul, type_float_, wx1, wy1);
+      spv::Id w_z = builder_->createNoContractionBinOp(spv::OpFMul, type_float_, wx1, wy0);
+      spv::Id w_w = builder_->createNoContractionBinOp(spv::OpFMul, type_float_, wx0, wy0);
+      spv::Id w4 = builder_->createCompositeConstruct(type_float4_, {w_x, w_y, w_z, w_w});
+      spv::Id prod4 = builder_->createNoContractionBinOp(spv::OpFMul, type_float4_, lit4, w4);
+
+      spv::Id s01 = builder_->createNoContractionBinOp(
+          spv::OpFAdd, type_float_, builder_->createCompositeExtract(prod4, type_float_, 0),
+          builder_->createCompositeExtract(prod4, type_float_, 1));
+      spv::Id s23 = builder_->createNoContractionBinOp(
+          spv::OpFAdd, type_float_, builder_->createCompositeExtract(prod4, type_float_, 2),
+          builder_->createCompositeExtract(prod4, type_float_, 3));
+      return builder_->createNoContractionBinOp(spv::OpFAdd, type_float_, s01, s23);
+    };
+
+    spv::Id is_bilinear = builder_->createBinOp(spv::OpIEqual, type_bool_, pcf_mode,
+                                                builder_->makeUintConstant(1));
+    SpirvBuilder::IfBuilder if_bilinear(is_bilinear, spv::SelectionControlDontFlattenMask,
+                                        *builder_);
+    spv::Id lit_bilinear;
+    {
+      // Mode 1: 2x2 Bilinear PCF (1 gather = 4 taps).
+      spv::Id sampled_img =
+          builder_->createBinOp(spv::OpSampledImage, sampled_image_type, image, sampler);
+      spv::Id om_fx =
+          builder_->createNoContractionBinOp(spv::OpFSub, type_float_, const_float_1_, fx);
+      spv::Id om_fy =
+          builder_->createNoContractionBinOp(spv::OpFSub, type_float_, const_float_1_, fy);
+      lit_bilinear = emit_gather_contrib(sampled_img, 0.0f, 0.0f, om_fx, fx, om_fy, fy);
+    }
+    if_bilinear.makeBeginElse();
+    spv::Id lit_soft_or_ultra;
+    {
+      spv::Id is_soft = builder_->createBinOp(spv::OpIEqual, type_bool_, pcf_mode,
+                                              builder_->makeUintConstant(2));
+      SpirvBuilder::IfBuilder if_soft(is_soft, spv::SelectionControlDontFlattenMask, *builder_);
+      spv::Id lit_soft;
+      {
+        // Mode 2: 4x4 Uniform Cubic B-Spline PCF (4 gathers = 16 taps, C2 continuous).
+        spv::Id sampled_img =
+            builder_->createBinOp(spv::OpSampledImage, sampled_image_type, image, sampler);
+        auto make_cubic_weights = [&](spv::Id t, spv::Id w_out[4]) {
+          spv::Id inv6 = builder_->makeFloatConstant(1.0f / 6.0f);
+          spv::Id c3 = builder_->makeFloatConstant(3.0f);
+          spv::Id c4 = builder_->makeFloatConstant(4.0f);
+          spv::Id c6 = builder_->makeFloatConstant(6.0f);
+          spv::Id om =
+              builder_->createNoContractionBinOp(spv::OpFSub, type_float_, const_float_1_, t);
+          spv::Id t2 = builder_->createNoContractionBinOp(spv::OpFMul, type_float_, t, t);
+          spv::Id t3 = builder_->createNoContractionBinOp(spv::OpFMul, type_float_, t2, t);
+          spv::Id om2 = builder_->createNoContractionBinOp(spv::OpFMul, type_float_, om, om);
+          spv::Id om3 = builder_->createNoContractionBinOp(spv::OpFMul, type_float_, om2, om);
+          // w0 = (1 - t)^3 / 6
+          w_out[0] = builder_->createNoContractionBinOp(spv::OpFMul, type_float_, om3, inv6);
+          // w1 = (3t^3 - 6t^2 + 4) / 6
+          spv::Id num1 = builder_->createNoContractionBinOp(
+              spv::OpFAdd, type_float_,
+              builder_->createNoContractionBinOp(
+                  spv::OpFSub, type_float_,
+                  builder_->createNoContractionBinOp(spv::OpFMul, type_float_, c3, t3),
+                  builder_->createNoContractionBinOp(spv::OpFMul, type_float_, c6, t2)),
+              c4);
+          w_out[1] = builder_->createNoContractionBinOp(spv::OpFMul, type_float_, num1, inv6);
+          // w2 = (-3t^3 + 3t^2 + 3t + 1) / 6
+          spv::Id num2 = builder_->createNoContractionBinOp(
+              spv::OpFAdd, type_float_,
+              builder_->createNoContractionBinOp(
+                  spv::OpFAdd, type_float_,
+                  builder_->createNoContractionBinOp(
+                      spv::OpFSub, type_float_,
+                      builder_->createNoContractionBinOp(spv::OpFMul, type_float_, c3, t2),
+                      builder_->createNoContractionBinOp(spv::OpFMul, type_float_, c3, t3)),
+                  builder_->createNoContractionBinOp(spv::OpFMul, type_float_, c3, t)),
+              const_float_1_);
+          w_out[2] = builder_->createNoContractionBinOp(spv::OpFMul, type_float_, num2, inv6);
+          // w3 = t^3 / 6
+          w_out[3] = builder_->createNoContractionBinOp(spv::OpFMul, type_float_, t3, inv6);
+        };
+        spv::Id wx[4], wy[4];
+        make_cubic_weights(fx, wx);
+        make_cubic_weights(fy, wy);
+
+        spv::Id g00 = emit_gather_contrib(sampled_img, -1.0f, -1.0f, wx[0], wx[1], wy[0], wy[1]);
+        spv::Id g10 = emit_gather_contrib(sampled_img, 1.0f, -1.0f, wx[2], wx[3], wy[0], wy[1]);
+        spv::Id g01 = emit_gather_contrib(sampled_img, -1.0f, 1.0f, wx[0], wx[1], wy[2], wy[3]);
+        spv::Id g11 = emit_gather_contrib(sampled_img, 1.0f, 1.0f, wx[2], wx[3], wy[2], wy[3]);
+        spv::Id row0 = builder_->createNoContractionBinOp(spv::OpFAdd, type_float_, g00, g10);
+        spv::Id row1 = builder_->createNoContractionBinOp(spv::OpFAdd, type_float_, g01, g11);
+        lit_soft = builder_->createNoContractionBinOp(spv::OpFAdd, type_float_, row0, row1);
+      }
+      if_soft.makeBeginElse();
+      spv::Id lit_ultra;
+      {
+        // Mode 3: 6x6 Symmetric Tent PCF (9 gathers = 36 taps, [1,2,3,2,1]/9 at centers).
+        spv::Id sampled_img =
+            builder_->createBinOp(spv::OpSampledImage, sampled_image_type, image, sampler);
+        auto make_tent6_weights = [&](spv::Id t, spv::Id w_out[6]) {
+          spv::Id inv9 = builder_->makeFloatConstant(1.0f / 9.0f);
+          spv::Id c2 = builder_->makeFloatConstant(2.0f);
+          spv::Id c3 = builder_->makeFloatConstant(3.0f);
+          w_out[0] = builder_->createNoContractionBinOp(
+              spv::OpFMul, type_float_,
+              builder_->createNoContractionBinOp(spv::OpFSub, type_float_, const_float_1_, t),
+              inv9);
+          w_out[1] = builder_->createNoContractionBinOp(
+              spv::OpFMul, type_float_,
+              builder_->createNoContractionBinOp(spv::OpFSub, type_float_, c2, t), inv9);
+          w_out[2] = builder_->createNoContractionBinOp(
+              spv::OpFMul, type_float_,
+              builder_->createNoContractionBinOp(spv::OpFSub, type_float_, c3, t), inv9);
+          w_out[3] = builder_->createNoContractionBinOp(
+              spv::OpFMul, type_float_,
+              builder_->createNoContractionBinOp(spv::OpFAdd, type_float_, c2, t), inv9);
+          w_out[4] = builder_->createNoContractionBinOp(
+              spv::OpFMul, type_float_,
+              builder_->createNoContractionBinOp(spv::OpFAdd, type_float_, const_float_1_, t),
+              inv9);
+          w_out[5] = builder_->createNoContractionBinOp(spv::OpFMul, type_float_, t, inv9);
+        };
+        spv::Id wx[6], wy[6];
+        make_tent6_weights(fx, wx);
+        make_tent6_weights(fy, wy);
+
+        static constexpr float kOffsets[3] = {-2.0f, 0.0f, 2.0f};
+        spv::Id acc = spv::NoResult;
+        for (int gy_i = 0; gy_i < 3; ++gy_i) {
+          for (int gx_i = 0; gx_i < 3; ++gx_i) {
+            spv::Id contrib = emit_gather_contrib(
+                sampled_img, kOffsets[gx_i], kOffsets[gy_i], wx[gx_i * 2], wx[gx_i * 2 + 1],
+                wy[gy_i * 2], wy[gy_i * 2 + 1]);
+            acc = (acc == spv::NoResult)
+                      ? contrib
+                      : builder_->createNoContractionBinOp(spv::OpFAdd, type_float_, acc, contrib);
+          }
+        }
+        lit_ultra = acc;
+      }
+      if_soft.makeEndIf();
+      lit_soft_or_ultra = if_soft.createMergePhi(lit_soft, lit_ultra);
+    }
+    if_bilinear.makeEndIf();
+    pcf_lit = if_bilinear.createMergePhi(lit_bilinear, lit_soft_or_ultra);
+  }
+  if_pcf.makeEndIf();
+  return if_pcf.createMergePhi(pcf_lit, original_lit);
+}
+
 }  // namespace rex::graphics
