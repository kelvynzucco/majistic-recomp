+VkImage VulkanTextureCache::PrepareDirectColorCopyTarget(DirectShadowResolveHandle texture) {
+  auto& vulkan_texture = *static_cast<VulkanTexture*>(texture);
+  vulkan_texture.MarkAsUsed();
+  auto old_usage = vulkan_texture.SetUsage(VulkanTexture::Usage::kTransferDestination);
+  VkPipelineStageFlags src_stage;
+  VkAccessFlags src_access;
+  VkImageLayout old_layout;
+  GetTextureUsageMasks(old_usage, src_stage, src_access, old_layout);
+  command_processor_.PushImageMemoryBarrier(
+      vulkan_texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, src_access, VK_ACCESS_TRANSFER_WRITE_BIT, old_layout,
+      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED,
+      false);
+  return vulkan_texture.image();
+}
+
 bool VulkanTextureCache::FinalizeDirectShadowResolveTarget(DirectShadowResolveHandle texture) {
   return FinalizeDirectResolvedTexture(*texture);
