+  // Per-submission cache for dynamic UBO constant descriptor sets, keyed by the 5 VkBuffer handles.
+  static constexpr uint32_t kConstantsDescriptorCacheCapacity = 16;
+  struct ConstantsDescriptorCacheEntry {
+    VkBuffer buffers[SpirvShaderTranslator::kConstantBufferCount]{};
+    VkDescriptorSet descriptor_set = VK_NULL_HANDLE;
+    uint32_t last_used_tick = 0;
+  };
+  struct ConstantsDescriptorCache {
+    std::array<ConstantsDescriptorCacheEntry, kConstantsDescriptorCacheCapacity> entries{};
+    uint32_t count = 0;
+    uint32_t last_hit_index = 0;
+    uint32_t tick = 0;
+
+    void Clear() {
+      count = 0;
+      last_hit_index = 0;
+      tick = 0;
+    }
+
+    static bool EntryMatches(const ConstantsDescriptorCacheEntry& e,
+                             const VkDescriptorBufferInfo* infos) {
+      for (uint32_t i = 0; i < SpirvShaderTranslator::kConstantBufferCount; ++i) {
+        if (e.buffers[i] != infos[i].buffer) {
+          return false;
+        }
+      }
+      return true;
+    }
+
+    VkDescriptorSet Find(const VkDescriptorBufferInfo* infos) {
+      if (count == 0) {
+        return VK_NULL_HANDLE;
+      }
+      if (EntryMatches(entries[last_hit_index], infos)) {
+        entries[last_hit_index].last_used_tick = ++tick;
+        return entries[last_hit_index].descriptor_set;
+      }
+      for (uint32_t i = 0; i < count; ++i) {
+        if (i == last_hit_index) {
+          continue;
+        }
+        if (EntryMatches(entries[i], infos)) {
+          entries[i].last_used_tick = ++tick;
+          last_hit_index = i;
+          return entries[i].descriptor_set;
+        }
+      }
+      return VK_NULL_HANDLE;
+    }
+
+    void Insert(const VkDescriptorBufferInfo* infos, VkDescriptorSet descriptor_set) {
+      uint32_t slot;
+      if (count < kConstantsDescriptorCacheCapacity) {
+        slot = count++;
+      } else {
+        slot = 0;
+        uint32_t oldest_tick = entries[0].last_used_tick;
+        for (uint32_t i = 1; i < kConstantsDescriptorCacheCapacity; ++i) {
+          if (entries[i].last_used_tick < oldest_tick) {
+            oldest_tick = entries[i].last_used_tick;
+            slot = i;
+          }
+        }
+      }
+      ConstantsDescriptorCacheEntry& e = entries[slot];
+      for (uint32_t i = 0; i < SpirvShaderTranslator::kConstantBufferCount; ++i) {
+        e.buffers[i] = infos[i].buffer;
+      }
+      e.descriptor_set = descriptor_set;
+      e.last_used_tick = ++tick;
+      last_hit_index = slot;
+    }
+  };
+  ConstantsDescriptorCache constants_descriptor_cache_;
