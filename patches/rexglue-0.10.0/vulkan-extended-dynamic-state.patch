+        deferred_command_buffer_.CmdVkSetColorBlendEnableEXT(0, xenos::kMaxColorRenderTargets,
+                                                             blend_enables);
+        dynamic_color_blend_enable_update_needed_ = false;
+      }
+    }
+    if (device_properties.extendedDynamicState3ColorBlendEquation) {
+      if (dynamic_color_blend_equation_update_needed_ ||
+          std::memcmp(dynamic_color_blend_equations_, blend_equations,
+                      sizeof(blend_equations)) != 0) {
+        std::memcpy(dynamic_color_blend_equations_, blend_equations, sizeof(blend_equations));
+        deferred_command_buffer_.CmdVkSetColorBlendEquationEXT(0, xenos::kMaxColorRenderTargets,
+                                                               blend_equations);
+        dynamic_color_blend_equation_update_needed_ = false;
+      }
+    }
+    if (device_properties.extendedDynamicState3ColorWriteMask) {
+      if (dynamic_color_write_mask_update_needed_ ||
+          std::memcmp(dynamic_color_write_masks_, write_masks, sizeof(write_masks)) != 0) {
+        std::memcpy(dynamic_color_write_masks_, write_masks, sizeof(write_masks));
+        deferred_command_buffer_.CmdVkSetColorWriteMaskEXT(0, xenos::kMaxColorRenderTargets,
+                                                           write_masks);
+        dynamic_color_write_mask_update_needed_ = false;
+      }
+    }
+  }
