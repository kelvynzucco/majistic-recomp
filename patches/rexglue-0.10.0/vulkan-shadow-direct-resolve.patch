+void VulkanTextureCache::FindDirectShadowResolveTargets(
+    uint32_t copy_dest_base, uint32_t copy_dest_extent_length, uint32_t guest_width,
+    uint32_t guest_height, xenos::TextureFormat expected_format, uint32_t shadow_scale,
+    std::vector<DirectShadowResolveHandle>& targets_out) {
+  targets_out.clear();
+  if ((copy_dest_base & 0xFFFu) != 0 || shadow_scale <= 1) {
+    return;
+  }
+  const uint32_t target_base_page = copy_dest_base >> 12;
+  const uint32_t expected_host_w = guest_width * shadow_scale;
+  const uint32_t expected_host_h = guest_height * shadow_scale;
+  for (const auto& pair : textures()) {
+    const TextureKey& key = pair.first;
+    if (key.base_page != target_base_page || !key.scaled_resolve || !key.tiled ||
+        key.dimension != xenos::DataDimension::k2DOrStacked || key.mip_max_level != 0 ||
+        key.format != expected_format || key.GetWidth() != guest_width ||
+        key.GetHeight() != guest_height || !TextureKey::IsShadowMapTexture(key)) {
+      continue;
+    }
+    auto* vulkan_tex = static_cast<VulkanTexture*>(pair.second.get());
+    if (!vulkan_tex || vulkan_tex->storage_view() == VK_NULL_HANDLE ||
+        vulkan_tex->force_load_3d_tiling() || vulkan_tex->resolution_scale() != shadow_scale ||
+        vulkan_tex->host_width() != expected_host_w ||
+        vulkan_tex->host_height() != expected_host_h ||
+        copy_dest_extent_length < vulkan_tex->GetGuestBaseSize()) {
+      continue;
+    }
+    targets_out.push_back(vulkan_tex);
+  }
+}
+
+VkImageView VulkanTextureCache::PrepareDirectShadowResolveTarget(
+    DirectShadowResolveHandle texture) {
+  auto& vulkan_texture = *static_cast<VulkanTexture*>(texture);
+  vulkan_texture.MarkAsUsed();
+  auto old_usage = vulkan_texture.SetUsage(VulkanTexture::Usage::kComputeDestination);
+  VkPipelineStageFlags src_stage;
+  VkAccessFlags src_access;
+  VkImageLayout old_layout;
+  GetTextureUsageMasks(old_usage, src_stage, src_access, old_layout);
+  command_processor_.PushImageMemoryBarrier(
+      vulkan_texture.image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, src_access, VK_ACCESS_SHADER_WRITE_BIT, old_layout,
+      VK_IMAGE_LAYOUT_GENERAL, VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, false);
+  return vulkan_texture.storage_view();
+}
+
+bool VulkanTextureCache::FinalizeDirectShadowResolveTarget(DirectShadowResolveHandle texture) {
+  return FinalizeDirectResolvedTexture(*texture);
+}
