+bool VulkanRenderTargetCache::CreateShadowDirectResolvePipelines() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  VkDescriptorSetLayout set_layouts[] = {
+      command_processor_.GetSingleTransientDescriptorLayout(
+          VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageImageCompute),
+      descriptor_set_layout_sampled_image_x2_,
+  };
+  VkPushConstantRange pc_range;
+  pc_range.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+  pc_range.offset = 0;
+  pc_range.size = sizeof(ShadowDirectResolvePushConstants);
+  VkPipelineLayoutCreateInfo layout_info = {};
+  layout_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+  layout_info.setLayoutCount = uint32_t(rex::countof(set_layouts));
+  layout_info.pSetLayouts = set_layouts;
+  layout_info.pushConstantRangeCount = 1;
+  layout_info.pPushConstantRanges = &pc_range;
+  if (dfn.vkCreatePipelineLayout(device, &layout_info, nullptr,
+                                 &shadow_direct_resolve_pipeline_layout_) != VK_SUCCESS) {
+    shadow_direct_resolve_pipeline_layout_ = VK_NULL_HANDLE;
+    return false;
+  }
+
+  for (uint32_t format_idx = 0; format_idx < 2; ++format_idx) {
+    const bool is_float24 =
+        (format_idx == uint32_t(xenos::DepthRenderTargetFormat::kD24FS8));
+    SpirvBuilder builder(spv::Spv_1_0, (SpirvShaderTranslator::kSpirvMagicToolId << 16) | 1,
+                         nullptr);
+    spv::Id ext_glsl = builder.import("GLSL.std.450");
+    builder.addCapability(spv::CapabilityShader);
+    builder.setMemoryModel(spv::AddressingModelLogical, spv::MemoryModelGLSL450);
+    builder.setSource(spv::SourceLanguageUnknown, 0);
+
+    spv::Id type_void = builder.makeVoidType();
+    spv::Id type_bool = builder.makeBoolType();
+    spv::Id type_int = builder.makeIntType(32);
+    spv::Id type_int2 = builder.makeVectorType(type_int, 2);
+    spv::Id type_uint = builder.makeUintType(32);
+    spv::Id type_uint3 = builder.makeVectorType(type_uint, 3);
+    spv::Id type_uint4 = builder.makeVectorType(type_uint, 4);
+    spv::Id type_float = builder.makeFloatType(32);
+    spv::Id type_float4 = builder.makeVectorType(type_float, 4);
+
+    // Set 0, binding 0: writeonly uimage2D (R32_UINT storage view over R32_SFLOAT shadow texture).
+    spv::Id dest_image = builder.createVariable(
+        spv::NoPrecision, spv::StorageClassUniformConstant,
+        builder.makeImageType(type_uint, spv::Dim2D, false, false, false, 2,
+                              spv::ImageFormatR32ui),
+        "dest_img");
+    builder.addDecoration(dest_image, spv::DecorationDescriptorSet, 0);
+    builder.addDecoration(dest_image, spv::DecorationBinding, 0);
+    builder.addDecoration(dest_image, spv::DecorationNonReadable);
+
+    // Set 1, binding 0: texture2D (1xMSAA depth image view from VulkanRenderTarget).
+    spv::Id src_depth = builder.createVariable(
+        spv::NoPrecision, spv::StorageClassUniformConstant,
+        builder.makeImageType(type_float, spv::Dim2D, false, false, false, 1,
+                              spv::ImageFormatUnknown),
+        "src_depth");
+    builder.addDecoration(src_depth, spv::DecorationDescriptorSet, 1);
+    builder.addDecoration(src_depth, spv::DecorationBinding, 0);
+
+    // Push constants: src_offset_x, src_offset_y, width, height, flags.
+    std::vector<spv::Id> pc_members(5, type_uint);
+    spv::Id type_pc = builder.makeStructType(pc_members, "ShadowDirectResolvePC");
+    for (uint32_t i = 0; i < 5; ++i) {
+      builder.addMemberDecoration(type_pc, i, spv::DecorationOffset, int(sizeof(uint32_t) * i));
+    }
+    builder.addDecoration(type_pc, spv::DecorationBlock);
+    spv::Id pc_var =
+        builder.createVariable(spv::NoPrecision, spv::StorageClassPushConstant, type_pc, "pc");
+
+    spv::Id input_gid = builder.createVariable(spv::NoPrecision, spv::StorageClassInput, type_uint3,
+                                               "gl_GlobalInvocationID");
+    builder.addDecoration(input_gid, spv::DecorationBuiltIn, spv::BuiltInGlobalInvocationId);
+
+    std::vector<spv::Id> main_params;
+    std::vector<std::vector<spv::Decoration>> main_precs;
+    spv::Block* main_entry;
+    spv::Function* main_fn = builder.makeFunctionEntry(spv::NoPrecision, type_void, "main",
+                                                       main_params, main_precs, &main_entry);
+
+    auto load_pc = [&](int member_idx) -> spv::Id {
+      std::vector<spv::Id> idx = {builder.makeIntConstant(member_idx)};
+      return builder.createLoad(
+          builder.createAccessChain(spv::StorageClassPushConstant, pc_var, idx), spv::NoPrecision);
+    };
+
+    spv::Id gid = builder.createLoad(input_gid, spv::NoPrecision);
+    spv::Id x = builder.createCompositeExtract(gid, type_uint, 0);
+    spv::Id y = builder.createCompositeExtract(gid, type_uint, 1);
+    spv::Id width = load_pc(2);
+    spv::Id height = load_pc(3);
+
+    spv::Id in_bounds = builder.createBinOp(
+        spv::OpLogicalAnd, type_bool, builder.createBinOp(spv::OpULessThan, type_bool, x, width),
+        builder.createBinOp(spv::OpULessThan, type_bool, y, height));
+    spv::Block& then_block = builder.makeNewBlock();
+    spv::Block& merge_block = builder.makeNewBlock();
+    builder.createSelectionMerge(&merge_block, spv::SelectionControlMaskNone);
+    builder.createConditionalBranch(in_bounds, &then_block, &merge_block);
+    builder.setBuildPoint(&then_block);
+
+    spv::Id src_offset_x = load_pc(0);
+    spv::Id src_offset_y = load_pc(1);
+    spv::Id flags = load_pc(4);
+    spv::Id const_u0 = builder.makeUintConstant(0);
+    spv::Id const_u1 = builder.makeUintConstant(1);
+    spv::Id const_u3 = builder.makeUintConstant(3);
+    spv::Id const_u4 = builder.makeUintConstant(4);
+
+    spv::Id fill_hpo = builder.createBinOp(
+        spv::OpINotEqual, type_bool,
+        builder.createBinOp(spv::OpBitwiseAnd, type_uint, flags, const_u1), const_u0);
+    spv::Id hx = builder.createTriOp(spv::OpBitFieldUExtract, type_uint, flags, const_u1, const_u3);
+    spv::Id hy = builder.createTriOp(spv::OpBitFieldUExtract, type_uint, flags, const_u4, const_u3);
+    spv::Id px = builder.createTriOp(
+        spv::OpSelect, type_uint, fill_hpo,
+        builder.createBinBuiltinCall(type_uint, ext_glsl, GLSLstd450UMax, x, hx), x);
+    spv::Id py = builder.createTriOp(
+        spv::OpSelect, type_uint, fill_hpo,
+        builder.createBinBuiltinCall(type_uint, ext_glsl, GLSLstd450UMax, y, hy), y);
+
+    spv::Id sx = builder.createBinOp(spv::OpIAdd, type_uint, src_offset_x, px);
+    spv::Id sy = builder.createBinOp(spv::OpIAdd, type_uint, src_offset_y, py);
+    std::vector<spv::Id> src_coords_vec = {
+        builder.createUnaryOp(spv::OpBitcast, type_int, sx),
+        builder.createUnaryOp(spv::OpBitcast, type_int, sy),
+    };
+    spv::Builder::TextureParameters tp = {};
+    tp.sampler = builder.createLoad(src_depth, spv::NoPrecision);
+    tp.coords = builder.createCompositeConstruct(type_int2, src_coords_vec);
+    tp.lod = builder.makeIntConstant(0);
+    spv::Id fetched = builder.createTextureCall(spv::NoPrecision, type_float4, false, true, false,
+                                                false, false, tp, spv::ImageOperandsMaskNone);
+    spv::Id depth_f = builder.createCompositeExtract(fetched, type_float, 0);
+
+    spv::Id depth_u;
+    if (is_float24) {
+      // Exact bit-for-bit match to GetDumpPipeline (host [0, 0.5] -> guest 20e4 [0, 1]) +
+      // texture_load_32bpb_scaled_image (guest 20e4 -> float32 bits).
+      spv::Id depth_20e4 = SpirvShaderTranslator::PreClampedDepthTo20e4(
+          builder, depth_f, depth_float24_round(), true, ext_glsl);
+      depth_u = SpirvShaderTranslator::Depth20e4To32(builder, depth_20e4, 0, false, true, ext_glsl);
+    } else {
+      // Exact bit-for-bit match to GetDumpPipeline (UNORM24 roundEven) +
+      // texture_load_32bpb_scaled_image ((d24 + (d24 >> 23)) / 16777216.0).
+      spv::Id depth_clamped = builder.createTriBuiltinCall(
+          type_float, ext_glsl, GLSLstd450NClamp, depth_f, builder.makeFloatConstant(0.0f),
+          builder.makeFloatConstant(1.0f));
+      spv::Id d24 = builder.createUnaryOp(
+          spv::OpConvertFToU, type_uint,
+          builder.createUnaryBuiltinCall(
+              type_float, ext_glsl, GLSLstd450RoundEven,
+              builder.createBinOp(spv::OpFMul, type_float, depth_clamped,
+                                  builder.makeFloatConstant(float(0xFFFFFF)))));
+      spv::Id d24_adj = builder.createBinOp(
+          spv::OpIAdd, type_uint, d24,
+          builder.createBinOp(spv::OpShiftRightLogical, type_uint, d24,
+                              builder.makeUintConstant(23)));
+      spv::Id d_f32 = builder.createBinOp(
+          spv::OpFMul, type_float, builder.createUnaryOp(spv::OpConvertUToF, type_float, d24_adj),
+          builder.makeFloatConstant(1.0f / 16777216.0f));
+      depth_u = builder.createUnaryOp(spv::OpBitcast, type_uint, d_f32);
+    }
+
+    std::vector<spv::Id> dst_coords_vec = {
+        builder.createUnaryOp(spv::OpBitcast, type_int, x),
+        builder.createUnaryOp(spv::OpBitcast, type_int, y),
+    };
+    spv::Id dst_coords = builder.createCompositeConstruct(type_int2, dst_coords_vec);
+    std::vector<spv::Id> texel_vec = {depth_u, const_u0, const_u0, const_u0};
+    spv::Id texel_u4 = builder.createCompositeConstruct(type_uint4, texel_vec);
+    spv::Id dst_loaded = builder.createLoad(dest_image, spv::NoPrecision);
+    std::vector<spv::Id> write_ops = {dst_loaded, dst_coords, texel_u4};
+    builder.createNoResultOp(spv::OpImageWrite, write_ops);
+
+    builder.createBranch(&merge_block);
+    builder.setBuildPoint(&merge_block);
+    builder.leaveFunction();
+
+    builder.addExecutionMode(main_fn, spv::ExecutionModeLocalSize, 16, 16, 1);
+    spv::Instruction* entry = builder.addEntryPoint(spv::ExecutionModelGLCompute, main_fn, "main");
+    entry->addIdOperand(input_gid);
+
+    std::vector<unsigned int> spirv;
+    builder.dump(spirv);
+    shadow_direct_resolve_pipelines_[format_idx] = ui::vulkan::util::CreateComputePipeline(
+        vulkan_device, shadow_direct_resolve_pipeline_layout_,
+        reinterpret_cast<const uint32_t*>(spirv.data()), sizeof(uint32_t) * spirv.size());
+    if (shadow_direct_resolve_pipelines_[format_idx] == VK_NULL_HANDLE) {
+      REXGPU_ERROR(
+          "VulkanRenderTargetCache: Failed to create shadow direct resolve compute pipeline ({})",
+          is_float24 ? "D24FS8" : "D24S8");
+      return false;
+    }
+    vulkan_device->SetObjectName(
+        VK_OBJECT_TYPE_PIPELINE, shadow_direct_resolve_pipelines_[format_idx],
+        is_float24 ? "Shadow Direct Depth Resolve (D24FS8)" : "Shadow Direct Depth Resolve (D24S8)");
+  }
+  return true;
+}
