+bool VulkanRenderTargetCache::TryResolveShadowDepthDirectly(
+    const draw_util::ResolveInfo& resolve_info, uint32_t res_scale_x, uint32_t res_scale_y,
+    VulkanTextureCache& texture_cache, uint32_t& written_address_out,
+    uint32_t& written_length_out) {
+  if (shadow_direct_resolve_pipeline_layout_ == VK_NULL_HANDLE) {
+    return false;
+  }
+  if (!resolve_info.IsCopyingDepth() || resolve_info.copy_dest_info.copy_dest_array ||
+      resolve_info.copy_dest_coordinate_info.offset_x_div_8 != 0 ||
+      resolve_info.copy_dest_coordinate_info.offset_y_div_8 != 0 ||
+      resolve_info.copy_dest_base != resolve_info.copy_dest_extent_start ||
+      (resolve_info.copy_dest_base & 0xFFFu) != 0 || res_scale_x != res_scale_y ||
+      res_scale_x <= 1 || resolve_info.depth_edram_info.msaa_samples != xenos::MsaaSamples::k1X) {
+    return false;
+  }
+
+  uint32_t dump_base, dump_row_length_used, dump_rows, dump_pitch;
+  resolve_info.GetCopyEdramTileSpan(dump_base, dump_row_length_used, dump_rows, dump_pitch);
+  GetResolveCopyRectanglesToDump(dump_base, dump_row_length_used, dump_rows, dump_pitch,
+                                 dump_rectangles_);
+  if (dump_rectangles_.size() != 1) {
+    return false;
+  }
+  const ResolveCopyDumpRectangle& rect = dump_rectangles_[0];
+  if (rect.row_first != 0 || rect.rows != dump_rows || rect.row_first_start != 0 ||
+      rect.row_last_end != dump_row_length_used) {
+    return false;
+  }
+  auto* src_rt = static_cast<VulkanRenderTarget*>(rect.render_target);
+  if (!src_rt || !src_rt->key().is_depth || !IsShadowMapDepthTarget(src_rt->key()) ||
+      src_rt->key().msaa_samples != xenos::MsaaSamples::k1X ||
+      src_rt->key().GetPitchTiles() != dump_pitch || src_rt->resolution_scale() != res_scale_x) {
+    return false;
+  }
+
+  const uint32_t copy_w = uint32_t(resolve_info.coordinate_info.width_div_8) << 3;
+  const uint32_t copy_h = uint32_t(resolve_info.height_div_8) << 3;
+  const uint32_t tile_delta =
+      (resolve_info.depth_edram_info.base_tiles - src_rt->key().base_tiles) &
+      (xenos::kEdramTileCount - 1);
+  const uint32_t tile_y = tile_delta / dump_pitch;
+  const uint32_t tile_x = tile_delta % dump_pitch;
+  const uint32_t guest_src_x =
+      tile_x * xenos::kEdramTileWidthSamples +
+      (uint32_t(resolve_info.coordinate_info.edram_offset_x_div_8) << 3);
+  const uint32_t guest_src_y =
+      tile_y * xenos::kEdramTileHeightSamples +
+      (uint32_t(resolve_info.coordinate_info.edram_offset_y_div_8) << 3);
+  const uint32_t rt_guest_w = src_rt->key().GetWidth();
+  const uint32_t rt_guest_h =
+      GetRenderTargetHeight(src_rt->key().pitch_tiles_at_32bpp, src_rt->key().msaa_samples);
+  if (guest_src_x + copy_w > rt_guest_w || guest_src_y + copy_h > rt_guest_h) {
+    return false;
+  }
+
+  const uint32_t depth_fmt_idx = uint32_t(src_rt->key().GetDepthFormat());
+  if (depth_fmt_idx >= 2 || shadow_direct_resolve_pipelines_[depth_fmt_idx] == VK_NULL_HANDLE) {
+    return false;
+  }
+  const xenos::TextureFormat expected_format =
+      DepthRenderTargetToTextureFormat(src_rt->key().GetDepthFormat());
+  texture_cache.FindDirectShadowResolveTargets(
+      resolve_info.copy_dest_base, resolve_info.copy_dest_extent_length, copy_w, copy_h,
+      expected_format, res_scale_x, direct_shadow_resolve_targets_);
+  if (direct_shadow_resolve_targets_.empty()) {
+    return false;
+  }
+
+  // Allocate transient destination descriptors before modifying range state.
+  VkDescriptorSet dest_sets_inline[4];
+  std::vector<VkDescriptorSet> dest_sets_heap;
+  VkDescriptorSet* dest_sets = dest_sets_inline;
+  const size_t target_count = direct_shadow_resolve_targets_.size();
+  if (target_count > rex::countof(dest_sets_inline)) {
+    dest_sets_heap.resize(target_count);
+    dest_sets = dest_sets_heap.data();
+  }
+  for (size_t i = 0; i < target_count; ++i) {
+    dest_sets[i] = command_processor_.AllocateSingleTransientDescriptor(
+        VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageImageCompute);
+    if (dest_sets[i] == VK_NULL_HANDLE) {
+      return false;
+    }
+  }
+
+  const uint32_t copy_dest_range_unscaled = resolve_info.copy_dest_extent_start -
+                                            resolve_info.copy_dest_base +
+                                            resolve_info.copy_dest_extent_length;
+  // Mark resolved ranges and notify shared memory first so all watches see the GPU write,
+  // then mark each directly populated shadow texture up-to-date and re-watched.
+  texture_cache.MarkShadowMapRangeAsResolved(resolve_info.copy_dest_base, copy_dest_range_unscaled);
+  texture_cache.MarkShadowMapRangeAsResolved(resolve_info.copy_dest_extent_start,
+                                             resolve_info.copy_dest_extent_length);
+  texture_cache.MarkRangeAsResolved(resolve_info.copy_dest_base, copy_dest_range_unscaled);
+  texture_cache.MarkRangeAsResolved(resolve_info.copy_dest_extent_start,
+                                    resolve_info.copy_dest_extent_length);
+
+  command_processor_.EndRenderPass();
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  const uint32_t host_w = copy_w * res_scale_x;
+  const uint32_t host_h = copy_h * res_scale_y;
+
+  // Transition source shadow depth RT for compute shader read.
+  command_processor_.PushImageMemoryBarrier(
+      src_rt->image(),
+      ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_DEPTH_BIT |
+                                                   VK_IMAGE_ASPECT_STENCIL_BIT),
+      src_rt->current_stage_mask(), VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      src_rt->current_access_mask(), VK_ACCESS_SHADER_READ_BIT, src_rt->current_layout(),
+      VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  src_rt->SetUsage(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+                   VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (size_t i = 0; i < target_count; ++i) {
+    VkImageView dst_view =
+        texture_cache.PrepareDirectShadowResolveTarget(direct_shadow_resolve_targets_[i]);
+    VkDescriptorImageInfo img_info = {};
+    img_info.imageView = dst_view;
+    img_info.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+    VkWriteDescriptorSet write = {};
+    write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    write.dstSet = dest_sets[i];
+    write.dstBinding = 0;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    write.pImageInfo = &img_info;
+    dfn.vkUpdateDescriptorSets(device, 1, &write, 0, nullptr);
+  }
+
+  command_processor_.SubmitBarriers(true);
+  command_processor_.BindExternalComputePipeline(shadow_direct_resolve_pipelines_[depth_fmt_idx]);
+  ShadowDirectResolvePushConstants pc = {};
+  pc.src_offset_x = guest_src_x * res_scale_x;
+  pc.src_offset_y = guest_src_y * res_scale_y;
+  pc.width = host_w;
+  pc.height = host_h;
+  pc.flags = uint32_t(resolve_info.depth_edram_info.fill_half_pixel_offset) |
+             ((res_scale_x >> 1) << 1) | ((res_scale_y >> 1) << 4);
+  command_buffer.CmdVkPushConstants(shadow_direct_resolve_pipeline_layout_,
+                                    VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(pc), &pc);
+  VkDescriptorSet src_set = src_rt->GetDescriptorSetTransferSource();
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         shadow_direct_resolve_pipeline_layout_, 1, 1, &src_set, 0,
+                                         nullptr);
+  const uint32_t groups_x = (host_w + 15) >> 4;
+  const uint32_t groups_y = (host_h + 15) >> 4;
+  for (size_t i = 0; i < target_count; ++i) {
+    command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                           shadow_direct_resolve_pipeline_layout_, 0, 1,
+                                           &dest_sets[i], 0, nullptr);
+    command_buffer.CmdVkDispatch(groups_x, groups_y, 1);
+    texture_cache.FinalizeDirectShadowResolveTarget(direct_shadow_resolve_targets_[i]);
+  }
+
+  written_address_out = resolve_info.copy_dest_extent_start;
+  written_length_out = resolve_info.copy_dest_extent_length;
+  return true;
+}
