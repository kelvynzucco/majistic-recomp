+void VulkanTextureCache::ClearCache() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+
+  TextureCache::ClearCache();
+
+  // Keep scaled_resolve_buffer_ and its already-committed sparse physical memory
+  // blocks alive across mid-game cache clears instead of destroying and
+  // recreating the 16 GB sparse buffer.
+  scaled_resolve_last_usage_write_ = false;
+  scaled_resolve_last_written_range_ = std::make_pair(uint64_t(0), uint64_t(0));
+  if (scaled_resolve_buffer_ == VK_NULL_HANDLE &&
+      (IsDrawResolutionScaled() ||
+       (vulkan_device && vulkan_device->properties().sparseResidencyBuffer))) {
+    if (!InitializeScaledResolveBuffer()) {
+      REXGPU_ERROR(
+          "VulkanTextureCache: Failed to initialize scaled resolve buffer in ClearCache");
+    }
+  }
+}
