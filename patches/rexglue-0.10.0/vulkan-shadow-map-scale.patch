+  float2 uv = (float2(pixel) + float2(0.5f, 0.5f)) * texel;
+  float3 c = xe_dedither_source.SampleLevel(xe_sampler_linear_clamp, uv, 0.0f).rgb;
+
+  uint depth_w = 0;
+  uint depth_h = 0;
+  xe_dedither_depth.GetDimensions(depth_w, depth_h);
+  int2 depth_max = int2(max(int(depth_w), 1) - 1, max(int(depth_h), 1) - 1);
+  int2 depth_p = (depth_w != xe_dedither_size.x || depth_h < xe_dedither_size.y)
+      ? int2(round(float2(p) * float2(depth_w, depth_h) * xe_dedither_size_inv))
