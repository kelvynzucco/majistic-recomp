+  int scaleVal = int(max(xe_dedither_scale.x, 1u));
+
+  float3 boxAvgScale;
+  float confScale = DetectDitherAtStep(p, depth_p, depth_max, scaleVal, boxAvgScale);
+
+  float confidence = confScale;
+  float3 bestBoxAvg = boxAvgScale;
+
+  if (scaleVal > 1) {
+    float3 boxAvgNative;
+    float confNative = DetectDitherAtStep(p, depth_p, depth_max, 1, boxAvgNative);
+    if (confNative > confidence) {
+      confidence = confNative;
+      bestBoxAvg = boxAvgNative;
+    }
+  }
+
+  float3 result = c;
+  if (xe_dedither_debug != 0u) {
+    if (pixel.x < 360u && pixel.y < 202u) {
+      if (pixel.x == 0u || pixel.x == 359u || pixel.y == 0u || pixel.y == 201u) {
+        result = float3(1.0f, 1.0f, 0.0f);
+      } else if (xe_dedither_has_depth == 0u) {
+        result = float3(1.0f, 0.0f, 0.0f);
+      } else {
+        int2 fullCoord = int2((float2(pixel) / float2(360.0f, 202.0f)) * float2(depth_max));
+        float pipZ = xe_dedither_depth.Load(int3(fullCoord, 0)).r;
+        float visZ = pow(saturate(pipZ), 0.35f);
+        result = float3(visZ, visZ, visZ);
+      }
+    } else {
+      if (confidence > 0.01f) {
+        float heatStrength = saturate(confidence * 1.5f * max(xe_dedither_strength, 0.2f));
+        result = lerp(c, float3(1.0f, 0.08f, 0.85f), heatStrength);
+      }
+    }
+  } else {
+    result = lerp(c, bestBoxAvg, saturate(confidence * xe_dedither_strength));
+  }
+
+  float outLuma = dot(result, kLumaWeights);
+  xe_dedither_dest[pixel] = float4(result, outLuma);
+}
