+float SampleOscillationAtStep(int2 dp, int stepVal, float depthScale, int2 depthMax) {
+  float zC  = xe_dedither_depth.Load(int3(dp, 0)).r;
+  float zN  = xe_dedither_depth.Load(int3(clamp(dp + int2( 0, -stepVal), int2(0, 0), depthMax), 0)).r;
+  float zS  = xe_dedither_depth.Load(int3(clamp(dp + int2( 0,  stepVal), int2(0, 0), depthMax), 0)).r;
+  float zE  = xe_dedither_depth.Load(int3(clamp(dp + int2( stepVal,  0), int2(0, 0), depthMax), 0)).r;
+  float zW  = xe_dedither_depth.Load(int3(clamp(dp + int2(-stepVal,  0), int2(0, 0), depthMax), 0)).r;
+  float zNW = xe_dedither_depth.Load(int3(clamp(dp + int2(-stepVal, -stepVal), int2(0, 0), depthMax), 0)).r;
+  float zNE = xe_dedither_depth.Load(int3(clamp(dp + int2( stepVal, -stepVal), int2(0, 0), depthMax), 0)).r;
+  float zSW = xe_dedither_depth.Load(int3(clamp(dp + int2(-stepVal,  stepVal), int2(0, 0), depthMax), 0)).r;
+  float zSE = xe_dedither_depth.Load(int3(clamp(dp + int2( stepVal,  stepVal), int2(0, 0), depthMax), 0)).r;
+
+  float dW = zW - zC;
+  float dE = zE - zC;
+  float dN = zN - zC;
+  float dS = zS - zC;
+  float dNW = zNW - zC;
+  float dSE = zSE - zC;
+  float dNE = zNE - zC;
+  float dSW = zSW - zC;
+
+  bool oscH  = (dW * dE > 0.0f);
+  bool oscV  = (dN * dS > 0.0f);
+  bool oscD1 = (dNW * dSE > 0.0f);
+  bool oscD2 = (dNE * dSW > 0.0f);
+
+  float strH  = oscH  ? min(abs(dW),  abs(dE))  : 0.0f;
+  float strV  = oscV  ? min(abs(dN),  abs(dS))  : 0.0f;
+  float strD1 = oscD1 ? min(abs(dNW), abs(dSE)) : 0.0f;
+  float strD2 = oscD2 ? min(abs(dNE), abs(dSW)) : 0.0f;
+  float maxOscStr = max(max(strH, strV), max(strD1, strD2));
+
+  return maxOscStr / depthScale;
+}
