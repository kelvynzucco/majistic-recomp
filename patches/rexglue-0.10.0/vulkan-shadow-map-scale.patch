+RWTexture2D<float4> xe_dedither_dest : register(u0);
+Texture2D<float4> xe_dedither_source : register(t0);
+Texture2D<float4> xe_dedither_depth : register(t1);
+SamplerState xe_sampler_linear_clamp : register(s0);
+
+static const float3 kLumaWeights = float3(0.299f, 0.587f, 0.114f);
