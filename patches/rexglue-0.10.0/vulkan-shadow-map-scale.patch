+D3D12RenderTargetCache::D3D12RenderTarget*
+D3D12RenderTargetCache::GetMainDepthRenderTarget(uint32_t width, uint32_t /*height*/) const {
+  if (GetPath() != Path::kHostRenderTargets) {
+    return nullptr;
+  }
+  auto IsValidSceneDepth = [this, width](D3D12RenderTarget* rt) -> bool {
+    if (!rt) return false;
+    const uint32_t guest_w = rt->key().GetWidth();
+    if (IsShadowMapDepthTarget(rt->key())) return false;
+    if (guest_w < 1280) return false;
+    const uint32_t host_w = guest_w * draw_resolution_scale_x();
+    if (width > 0 && host_w < width * 3 / 4 && guest_w < width * 3 / 4) return false;
+    return true;
+  };
+
+  if (IsValidSceneDepth(main_scene_depth_render_target_)) {
+    return main_scene_depth_render_target_;
+  }
+  if (IsValidSceneDepth(last_scene_depth_render_target_)) {
+    return last_scene_depth_render_target_;
+  }
+  return nullptr;
+}
