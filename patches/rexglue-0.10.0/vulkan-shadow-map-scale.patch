+float DetectDitherAtStep(int2 p, int2 dp, int2 depthMax, int stepVal, out float3 outBoxAvg) {
+  float2 texel = xe_dedither_size_inv;
+  float2 uv = (float2(p) + float2(0.5f, 0.5f)) * texel;
+  float2 st = float(stepVal) * texel;
+
+  float3 c  = xe_dedither_source.SampleLevel(xe_sampler_linear_clamp, uv, 0.0f).rgb;
+  float3 n  = xe_dedither_source.SampleLevel(xe_sampler_linear_clamp, uv + float2( 0.0f, -st.y), 0.0f).rgb;
+  float3 s  = xe_dedither_source.SampleLevel(xe_sampler_linear_clamp, uv + float2( 0.0f,  st.y), 0.0f).rgb;
+  float3 e  = xe_dedither_source.SampleLevel(xe_sampler_linear_clamp, uv + float2( st.x,  0.0f), 0.0f).rgb;
+  float3 w  = xe_dedither_source.SampleLevel(xe_sampler_linear_clamp, uv + float2(-st.x,  0.0f), 0.0f).rgb;
+  float3 nw = xe_dedither_source.SampleLevel(xe_sampler_linear_clamp, uv + float2(-st.x, -st.y), 0.0f).rgb;
+  float3 ne = xe_dedither_source.SampleLevel(xe_sampler_linear_clamp, uv + float2( st.x, -st.y), 0.0f).rgb;
+  float3 sw = xe_dedither_source.SampleLevel(xe_sampler_linear_clamp, uv + float2(-st.x,  st.y), 0.0f).rgb;
+  float3 se = xe_dedither_source.SampleLevel(xe_sampler_linear_clamp, uv + float2( st.x,  st.y), 0.0f).rgb;
+
+  float3 cardAvg = 0.25f * (n + s + e + w);
+  float3 diagAvg = 0.25f * (nw + ne + sw + se);
+  outBoxAvg = 0.5f * (cardAvg + diagAvg);
+
+  if (xe_dedither_has_depth == 0u) {
+    return 0.0f;
+  }
+
+  float zC = xe_dedither_depth.Load(int3(dp, 0)).r;
+  float depthScale = max(min(zC, 1.0f - zC), 0.0005f);
+
+  const float kMinRelOsc = 0.0025f;
+
+  float relOsc = SampleOscillationAtStep(dp, stepVal, depthScale, depthMax);
+
+  if (relOsc <= kMinRelOsc) {
+    float relOsc2 = SampleOscillationAtStep(dp, stepVal * 2, depthScale, depthMax);
+    if (relOsc2 > kMinRelOsc) {
+      relOsc = relOsc2;
+    }
+  }
+
+  float lumaC = dot(c, kLumaWeights);
+  float lumaN = dot(n, kLumaWeights);
+  float lumaS = dot(s, kLumaWeights);
+  float lumaE = dot(e, kLumaWeights);
+  float lumaW = dot(w, kLumaWeights);
+
+  float minCardLuma = min(min(lumaN, lumaS), min(lumaE, lumaW));
+  float maxCardLuma = max(max(lumaN, lumaS), max(lumaE, lumaW));
+  float cardRange   = maxCardLuma - minCardLuma;
+  float darkDrop    = minCardLuma - lumaC;
+
+  bool isDarkStipple = (darkDrop > 0.025f) && (cardRange < max(darkDrop * 1.5f, 0.07f));
+
+  if (relOsc <= kMinRelOsc && !isDarkStipple) {
+    return 0.0f;
+  }
+
+  float colorDiff = abs(dot(c - outBoxAvg, kLumaWeights));
+  if (colorDiff < 0.004f) {
+    return 0.0f;
+  }
+
+  float oscConf = saturate((relOsc - kMinRelOsc) / 0.015f);
+  float stippleConf = isDarkStipple ? saturate((darkDrop - 0.02f) / 0.06f) : 0.0f;
+  float geomConf = max(oscConf, stippleConf);
+
+  float colorConf = saturate((colorDiff - 0.004f) / 0.025f);
+  return geomConf * colorConf;
+}
