+layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;
+
+layout(push_constant) uniform XeSwapPostConstants {
+  uvec2 xe_dedither_size;
+  vec2 xe_dedither_size_inv;
+  uvec2 xe_dedither_scale;
+  uint xe_dedither_debug;
+  uint xe_dedither_has_depth;
+};
+
+layout(set = 0, binding = 0) uniform sampler2D xe_dedither_source;
+layout(set = 1, binding = 0, rgba16f) writeonly uniform image2D xe_dedither_dest;
+layout(set = 2, binding = 0) uniform sampler2D xe_dedither_depth;
+
+const vec3 kLumaWeights = vec3(0.299, 0.587, 0.114);
+
+float DetectDitherAtStep(vec2 uv, vec2 st, out vec3 outBoxAvg) {
+  vec3 c  = textureLod(xe_dedither_source, uv, 0.0).rgb;
+  vec3 n  = textureLod(xe_dedither_source, uv + vec2( 0.0, -st.y), 0.0).rgb;
+  vec3 s  = textureLod(xe_dedither_source, uv + vec2( 0.0,  st.y), 0.0).rgb;
+  vec3 e  = textureLod(xe_dedither_source, uv + vec2( st.x,  0.0), 0.0).rgb;
+  vec3 w  = textureLod(xe_dedither_source, uv + vec2(-st.x,  0.0), 0.0).rgb;
+  vec3 nw = textureLod(xe_dedither_source, uv + vec2(-st.x, -st.y), 0.0).rgb;
+  vec3 ne = textureLod(xe_dedither_source, uv + vec2( st.x, -st.y), 0.0).rgb;
+  vec3 sw = textureLod(xe_dedither_source, uv + vec2(-st.x,  st.y), 0.0).rgb;
+  vec3 se = textureLod(xe_dedither_source, uv + vec2( st.x,  st.y), 0.0).rgb;
+
+  vec3 cardAvg = 0.25 * (n + s + e + w);
+  vec3 diagAvg = 0.25 * (nw + ne + sw + se);
+  outBoxAvg = 0.5 * (cardAvg + diagAvg);
+
+  if (xe_dedither_has_depth == 0u) {
+    return 0.0;
+  }
+
+  // Sample depth buffer at center and all 8 neighbors (cardinals and diagonals)
+  float zC  = textureLod(xe_dedither_depth, uv, 0.0).r;
+  float zN  = textureLod(xe_dedither_depth, uv + vec2( 0.0, -st.y), 0.0).r;
+  float zS  = textureLod(xe_dedither_depth, uv + vec2( 0.0,  st.y), 0.0).r;
+  float zE  = textureLod(xe_dedither_depth, uv + vec2( st.x,  0.0), 0.0).r;
+  float zW  = textureLod(xe_dedither_depth, uv + vec2(-st.x,  0.0), 0.0).r;
+  float zNW = textureLod(xe_dedither_depth, uv + vec2(-st.x, -st.y), 0.0).r;
+  float zNE = textureLod(xe_dedither_depth, uv + vec2( st.x, -st.y), 0.0).r;
+  float zSW = textureLod(xe_dedither_depth, uv + vec2(-st.x,  st.y), 0.0).r;
+  float zSE = textureLod(xe_dedither_depth, uv + vec2( st.x,  st.y), 0.0).r;
+
+  // 1. Alternating depth oscillation check:
+  // On smooth continuous geometry, the depth derivative is monotonic across opposite directions,
+  // making (zW - zC) * (zE - zC) <= 0.
+  // In dithered alpha / screen-door perforations, foreground pixels alternate with background pixels,
+  // creating sharp opposite-sign peaks/valleys where the product is positive.
+  float zOscH  = (zW - zC) * (zE - zC);
+  float zOscV  = (zN - zC) * (zS - zC);
+  float zOscD1 = (zNW - zC) * (zSE - zC);
+  float zOscD2 = (zNE - zC) * (zSW - zC);
+
+  float zStrH  = (zOscH > 0.0)  ? min(abs(zW - zC), abs(zE - zC)) : 0.0;
+  float zStrV  = (zOscV > 0.0)  ? min(abs(zN - zC), abs(zS - zC)) : 0.0;
+  float zStrD1 = (zOscD1 > 0.0) ? min(abs(zNW - zC), abs(zSE - zC)) : 0.0;
+  float zStrD2 = (zOscD2 > 0.0) ? min(abs(zNE - zC), abs(zSW - zC)) : 0.0;
+
+  float maxZStr = max(max(zStrH, zStrV), max(zStrD1, zStrD2));
+
+  // 2. Planar surface deviation check (Laplacian):
+  // Smooth 3D meshes (character, clothes, ground, rocks) have near-zero second derivative.
+  // Screen-door transparency introduces massive jumps relative to local planar fit.
+  float zCardAvg = 0.25 * (zN + zS + zE + zW);
+  float zDiagAvg = 0.25 * (zNW + zNE + zSW + zSE);
+  float zPlanarDev = abs(zC - zCardAvg);
+  float zDiagDev = abs(zC - zDiagAvg);
+  float maxZDev = max(zPlanarDev, zDiagDev);
+
+  const float kDepthThreshold = 0.0004;
+  if (maxZStr > kDepthThreshold && maxZDev > kDepthThreshold) {
+    float depthConf = clamp((maxZDev - kDepthThreshold) / 0.006, 0.0, 1.0);
+    float colorDiff = abs(dot(c - outBoxAvg, kLumaWeights));
+    if (colorDiff > 0.005) {
+      return depthConf;
+    }
+  }
