+  float localMax = max(max(max(lumaN, lumaS), max(lumaE, lumaW)), max(max(lumaNW, lumaNE), max(lumaSW, lumaSE)));
+  float diffCard = abs(lumaC - dot(cardAvg, kLumaWeights));
+  float diffDiag = abs(lumaC - dot(diagAvg, kLumaWeights));
+  float minDiff = min(diffCard, diffDiag);
+  if ((lumaC < localMin || lumaC > localMax) && minDiff > 0.015) {
+    return clamp((minDiff - 0.015) / 0.12, 0.0, 1.0);
+  }
