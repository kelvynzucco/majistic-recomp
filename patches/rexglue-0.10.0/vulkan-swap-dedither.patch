+const char* GetSwapDeDitherComputeSource(bool output_fxaa_luma) {
+  return output_fxaa_luma ? R"(#version 450
+layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;
+
+layout(push_constant) uniform XeSwapPostConstants {
+  uvec2 xe_dedither_size;
+  vec2 xe_dedither_size_inv;
+};
+
+layout(set = 0, binding = 0) uniform sampler2D xe_dedither_source;
+layout(set = 1, binding = 0, rgba16f) writeonly uniform image2D xe_dedither_dest;
+
+const vec3 kLumaWeights = vec3(0.299, 0.587, 0.114);
+const float kDitherThreshold = 0.02;
+
+void main() {
+  uvec2 pixel = gl_GlobalInvocationID.xy;
+  if (any(greaterThanEqual(pixel, xe_dedither_size))) {
+    return;
+  }
+
+  vec2 texel = xe_dedither_size_inv;
+  vec2 uv = (vec2(pixel) + vec2(0.5)) * texel;
+
+  vec3 c  = textureLod(xe_dedither_source, uv, 0.0).rgb;
+  vec3 n  = textureLod(xe_dedither_source, uv + vec2( 0.0, -texel.y), 0.0).rgb;
+  vec3 s  = textureLod(xe_dedither_source, uv + vec2( 0.0,  texel.y), 0.0).rgb;
+  vec3 e  = textureLod(xe_dedither_source, uv + vec2( texel.x,  0.0), 0.0).rgb;
+  vec3 w  = textureLod(xe_dedither_source, uv + vec2(-texel.x,  0.0), 0.0).rgb;
+  vec3 nw = textureLod(xe_dedither_source, uv + vec2(-texel.x, -texel.y), 0.0).rgb;
+  vec3 ne = textureLod(xe_dedither_source, uv + vec2( texel.x, -texel.y), 0.0).rgb;
+  vec3 sw = textureLod(xe_dedither_source, uv + vec2(-texel.x,  texel.y), 0.0).rgb;
+  vec3 se = textureLod(xe_dedither_source, uv + vec2( texel.x,  texel.y), 0.0).rgb;
+
+  float lumaC  = dot(c,  kLumaWeights);
+  float lumaN  = dot(n,  kLumaWeights);
+  float lumaS  = dot(s,  kLumaWeights);
+  float lumaE  = dot(e,  kLumaWeights);
+  float lumaW  = dot(w,  kLumaWeights);
+  float lumaNW = dot(nw, kLumaWeights);
+  float lumaNE = dot(ne, kLumaWeights);
+  float lumaSW = dot(sw, kLumaWeights);
+  float lumaSE = dot(se, kLumaWeights);
+
+  vec3 cardAvg = 0.25 * (n + s + e + w);
+  float lumaCardAvg = 0.25 * (lumaN + lumaS + lumaE + lumaW);
+
+  float diffCenterCardLuma = abs(lumaC - lumaCardAvg);
+  vec3 diffCenterCardRgb = abs(c - cardAvg);
+  float diffCenterCard = max(diffCenterCardLuma, max(diffCenterCardRgb.r, max(diffCenterCardRgb.g, diffCenterCardRgb.b)));
+
+  float diagDiff = 0.25 * (abs(lumaC - lumaNW) + abs(lumaC - lumaNE) +
+                           abs(lumaC - lumaSW) + abs(lumaC - lumaSE));
+
+  float cardMin = min(min(lumaN, lumaS), min(lumaE, lumaW));
+  float cardMax = max(max(lumaN, lumaS), max(lumaE, lumaW));
+  float cardSpread = cardMax - cardMin;
+
+  float penalty = diagDiff + 0.5 * cardSpread;
+  float signal = diffCenterCard - penalty;
+
+  float confidence = 0.0;
+  if (signal > kDitherThreshold) {
+    confidence = clamp((signal - kDitherThreshold) / max(diffCenterCard - kDitherThreshold, 1e-4), 0.0, 1.0);
+  }
+
+  vec3 result = mix(c, cardAvg, 0.5 * confidence);
+  float outLuma = dot(result, kLumaWeights);
+  imageStore(xe_dedither_dest, ivec2(pixel), vec4(result, outLuma));
+}
+)"
